# Piazza SDK — Environment Configuration
# Copy this file to .env and fill in your values.
#
# All variables use the PIAZZA_ prefix and map to SessionConfig fields.
# Constructor arguments always take precedence over environment variables.

# ─── Required ────────────────────────────────────────────────────────
# The Piazza course/network ID (numeric, from the course URL).
PIAZZA_COURSE_ID=12345678

# ─── Optional ────────────────────────────────────────────────────────
# Custom User-Agent string.
# PIAZZA_USER_AGENT=piazza-sdk-python/2026.06.22

# Base URL for the Piazza API (HTTPS enforced).
# PIAZZA_BASE_URL=https://piazza.com

# HTTP request timeout in seconds.
# PIAZZA_TIMEOUT=30.0

# Number of retry attempts for transient failures (429, 5xx).
# PIAZZA_RETRIES=3

# Base delay between retries in seconds (exponential backoff).
# PIAZZA_RETRY_DELAY=1.0

# Path for persisting cookies to disk (enables session restore).
# PIAZZA_COOKIE_PATH=/path/to/cookies.json

# Fernet key for encrypting persisted cookies.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PIAZZA_ENCRYPTION_KEY=your_fernet_key_here
