# Piazza SDK — Environment Configuration
# Copy this file to .env and fill in your values.

# Piazza account credentials
PIAZZA_API_EMAIL=you@example.com
PIAZZA_API_PASSWORD=your_password_here

# Piazza course ID (numeric, from the course URL)
PIAZZA_COURSE_ID=12345678

# Optional: session encryption key (auto-generated if not set)
# SESSION_ENCRYPTION_KEY=
